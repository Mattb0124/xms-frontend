# Local development only.
#
# In the cluster every one of these is set by the Helm chart: the three
# upstream addresses come from deploy/values-dev.yaml, and the Kubernetes
# identity variables come from the downward API. Nothing here is a secret —
# this service has no Vault mount and no database credential, and that is
# asserted and rendered on /platform.
#
# None of these are NEXT_PUBLIC_*. They must not be: the browser never learns
# where the internal services live.

ENVIRONMENT=local
PORT=3000
SERVICE_NAME=xms-frontend
AWS_REGION=us-east-1

# The three internal services, reached server-side only. In the cluster these
# are cluster-DNS names that do not resolve anywhere else.
BACKEND_URL=http://localhost:3000
WORKER_URL=http://localhost:3002
MCP_URL=http://localhost:8000

# How long a single upstream call may take before it is given up on.
UPSTREAM_TIMEOUT_MS=8000
