# Copy to .env.local. NEXT_PUBLIC_* values are baked at build time and visible
# to the browser; never put a secret in one (see .claude/rules and the
# xms-security-first skill).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Server-only (never NEXT_PUBLIC_)
CLERK_SECRET_KEY=
# Where this build is going: local | dev | demo | production. It decides what
# the developer conveniences may do, so every pipeline sets it. Unset means
# local in a development build and production in a built one, so forgetting it
# closes the door rather than opening it (security review finding 27).
NEXT_PUBLIC_DEPLOY_TARGET=local
# Development sign-in (paste a token from the backend's `pnpm dev:token`).
# The pasted token lives in browser storage, so it is allowed only when
# NEXT_PUBLIC_DEPLOY_TARGET=local; turning it on for any other target fails
# the build. The /dev pages follow the same rule.
NEXT_PUBLIC_AUTH_DEV_MODE=false
